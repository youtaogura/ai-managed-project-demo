#!/usr/bin/env node
// テスト用の偽 gh。状態は $FAKE_STATE（JSON）に保存する。
// 1回の呼び出しの間ずっと状態ファイルのロックを持つ（並列ジョブからの同時呼び出しで更新が失われないように）
const fs = require('fs');
const { execFileSync } = require('child_process');
const state = require('./fake-state');
state.lock();
const st = state.read();
const save = () => state.write(st);
const a = process.argv.slice(2);
const out = (o) => process.stdout.write(typeof o === 'string' ? o : JSON.stringify(o));
const stdin = () => { try { return fs.readFileSync(0, 'utf8'); } catch { return ''; } };
const opt = (name) => { const i = a.indexOf(name); return i >= 0 ? a[i + 1] : undefined; };
const record = (msg) => { st.log.push(msg); save(); };
const STATUSES = ['Backlog', 'Ready', 'Spec', 'Implement', 'Review', 'Release', 'Done', 'Blocked'];

const [c1, c2] = a;
if (c1 === 'auth') { out('Logged in (fake)\n'); process.exit(0); }
if (c1 === 'label') { process.exit(0); }

if (c1 === 'api' && c2 === 'graphql') {
  const q = a.find((x) => x.startsWith('query=')).slice(6);
  if (q.includes('projectV2(number')) {
    return out({ data: { user: { projectV2: { id: 'P1', title: 'Fake Project', fields: { nodes: [
      {}, { id: 'F1', name: 'Status', options: STATUSES.map((s) => ({ id: `opt-${s}`, name: s })) } ] } } } } });
  }
  if (q.includes('items(first')) {
    return out({ data: { node: { items: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: st.items.map((i) => ({
      id: i.itemId, fieldValueByName: { name: i.status },
      content: { number: i.number, title: i.title, state: i.state, repository: { nameWithOwner: 'youtaogura/ai-managed-project-demo' },
        labels: { nodes: i.labels.map((name) => ({ name })) } } })) } } } });
  }
  if (q.includes('updateProjectV2ItemFieldValue')) {
    const item = a.find((x) => x.startsWith('item=')).slice(5);
    const option = a.find((x) => x.startsWith('option=')).slice(7).replace('opt-', '');
    const it = st.items.find((i) => i.itemId === item);
    record(`status #${it.number}: ${it.status} -> ${option}`);
    it.status = option; save();
    return out({ data: {} });
  }
  throw new Error('unknown graphql');
}

if (c1 === 'issue') {
  const n = Number(a[2]);
  const it = st.items.find((i) => i.number === n);
  if (c2 === 'edit' && opt('--add-label')) { it.labels.push(opt('--add-label')); record(`label #${n} +${opt('--add-label')}`); }
  if (c2 === 'comment') record(`comment #${n}: ${stdin().split('\n')[0]}`);
  if (c2 === 'close') { it.state = 'CLOSED'; record(`close #${n}`); }
  process.exit(0);
}

if (c1 === 'pr') {
  if (c2 === 'list') {
    const pr = st.prs[opt('--head')];
    return out(pr && pr.open ? [{ number: pr.number, url: `https://example/pr/${pr.number}`, title: 'x' }] : []);
  }
  if (c2 === 'create') {
    const head = opt('--head');
    st.prs[head] = { number: 100 + Object.keys(st.prs).length, open: true }; record(`pr create ${head}`);
    return out(`https://example/pr/${st.prs[head].number}\n`);
  }
  const n = Number(a[2]);
  const [branch] = Object.entries(st.prs).find(([, p]) => p.number === n) || [];
  if (c2 === 'view') {
    // GitHub と同じく、merge base からの差分
    const files = execFileSync('git', ['diff', '--name-only', `origin/main...origin/${branch}`], { cwd: process.env.REPO_DIR }).toString().trim().split('\n');
    return out({ files: files.filter(Boolean).map((path) => ({ path })) });
  }
  if (c2 === 'checks') {
    // 必須チェックを返す。FAKE_CI_FAIL_ISSUE は初回だけ失敗、FAKE_CI_MISSING_ISSUE は pr-policy が永遠に現れない
    const required = JSON.parse(fs.readFileSync(require('path').join(__dirname, '../../../policy.json'), 'utf8')).requiredChecks;
    const issue = branch.replace('agent/issue-', '');
    st.ciCalls = st.ciCalls || {};
    st.ciCalls[branch] = (st.ciCalls[branch] || 0) + 1;
    save();
    const failOnce = process.env.FAKE_CI_FAIL_ISSUE === issue && st.ciCalls[branch] === 1;
    const checks = required
      .filter((name) => !(process.env.FAKE_CI_MISSING_ISSUE === issue && name === 'pr-policy'))
      .map((name) => ({ name, bucket: failOnce && name === 'test-coverage' ? 'fail' : 'pass' }));
    checks.push({ name: 'optional-check', bucket: 'fail' }); // 必須でないチェックの失敗は無視されること
    return out(checks);
  }
  if (c2 === 'merge') {
    // origin の main に実際に squash マージする（後続の PR が behind / コンフリクトになるように）
    const origin = execFileSync('git', ['remote', 'get-url', 'origin'], { cwd: process.env.REPO_DIR }).toString().trim();
    const tmp = fs.mkdtempSync(require('path').join(require('os').tmpdir(), 'fake-merge-'));
    const g = (...args) => execFileSync('git', args, { cwd: tmp, stdio: ['ignore', 'pipe', 'pipe'] });
    let mergeable = true;
    try {
      g('clone', '-q', origin, '.');
      try {
        g('merge', '--squash', `origin/${branch}`);
        g('commit', '-qm', `t (#${n})`);
        g('push', '-q', 'origin', 'HEAD:main');
      } catch {
        mergeable = false;
      }
    } finally {
      fs.rmSync(tmp, { recursive: true, force: true });
    }
    if (!mergeable) {
      record(`pr merge #${n} failed`);
      console.error(`Pull request #${n} is not mergeable: the merge commit cannot be cleanly created.`);
      process.exit(1);
    }
    st.prs[branch].open = false; record(`pr merge #${n}`); process.exit(0);
  }
  if (c2 === 'comment' || c2 === 'review') { record(`pr ${c2} #${n}: ${(stdin() || '').split('\n')[0]}`); process.exit(0); }
}
console.error('fake gh: unsupported', a.join(' '));
process.exit(1);
