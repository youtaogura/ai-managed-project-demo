# 注意: 値の後ろに # コメントを書かないこと（値の一部として読まれる場合がある）

# ---- Claude Code の認証（どちらか一方）----
# API キー、または `claude setup-token` で発行した長期トークン
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# ---- GitHub ----
# classic PAT（scopes: repo, project）推奨。ユーザー所有の Project v2 は fine-grained PAT では操作できない場合がある
GH_TOKEN=
GITHUB_REPOSITORY=youtaogura/ai-managed-project-demo
PROJECT_OWNER=youtaogura
# user または organization
PROJECT_OWNER_TYPE=user
# Project の URL .../projects/<番号> の番号
PROJECT_NUMBER=

# Status の選択肢名を変える場合（既定: Backlog/Ready/Spec/Implement/Review/Release/Done/Blocked）
# STATUS_NAMES={"spec":"要件整理・設計","implement":"実装"}

# ---- Expo（任意）----
# 設定するとリリース時に Android の内部配布ビルドを依頼する（事前に app/ で `eas init` が必要）
EXPO_TOKEN=

# ---- コンテナ ----
# エージェント専用クローンの絶対パス（普段の作業コピーは指定しないこと）
AGENT_REPO_PATH=/Users/you/agent-work/ai-managed-project-demo
AGENT_LOG_PATH=./agent-logs
# Linux ホストではホストユーザーの UID/GID に合わせる（id -u / id -g）。macOS は既定のままで可
AGENT_UID=1000
AGENT_GID=1000
AGENT_MEM_LIMIT=6g
AGENT_CPUS=4

# ---- エージェントのコミット作者 ----
GIT_AUTHOR_NAME=ai-agent
GIT_AUTHOR_EMAIL=ai-agent@users.noreply.github.com

# ---- 実行制御 ----
# 同時に動かすセッション数
MAX_CONCURRENCY=2
POLL_INTERVAL_SEC=60
# 1工程あたりの最大ターン数とタイムアウト（分）
MAX_TURNS=80
JOB_TIMEOUT_MIN=45
# レビュー・CI による差し戻しの上限
MAX_REWORK=2
# Release でマージ前に必須とする CI チェック（既定: orchestrator/policy.json の requiredChecks）
# REQUIRED_CHECKS=lint-typecheck,test-coverage,build,dependencies,tooling,pr-policy
# 必須チェックの結果が出ないまま待つ上限（分）。超えたら Blocked
CI_TIMEOUT_MIN=30
# 1工程あたりの上限金額（API キー利用時のみ有効）
# MAX_BUDGET_USD=5
# CLAUDE_MODEL=
# 1 にすると GitHub への書き込みとエージェント起動をせず、計画だけ表示する
DRY_RUN=1
